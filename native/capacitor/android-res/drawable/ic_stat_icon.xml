<?xml version="1.0" encoding="utf-8"?>
<!-- The status bar icon for the recording notification.

     Kept here because android/ is generated by `cap add android` and is not in
     this repository: regenerating it silently drops this file, and the app is
     then back to a recording that dies with the screen. Copy it to
     android/app/src/main/res/drawable/ after any regeneration.

     This file not existing is why recording never survived the screen going off
     up to 1.2. The web app asks for smallIcon "ic_stat_icon". The plugin
     resolves that name to a drawable id, gets 0 for a missing one, and builds a
     notification with setSmallIcon(0). Android rejects such a notification, so
     startForeground throws, and it throws inside the service on another thread,
     long after the plugin has already resolved the JavaScript promise. The
     plugin logs it and returns START_STICKY. Nothing reaches the app. The
     service is running and is not a foreground service.

     Status bar icons must be a flat white silhouette on transparency. Android
     tints them and discards any colour set here. Deliberately a plain filled
     circle: at status bar size fine detail disappears, and a malformed path
     would fail to inflate and put the original bug straight back. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,5.5c3.59,0 6.5,2.91 6.5,6.5s-2.91,6.5 -6.5,6.5s-6.5,-2.91 -6.5,-6.5s2.91,-6.5 6.5,-6.5z" />
</vector>
