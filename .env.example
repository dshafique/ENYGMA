# ENYGMA — copy to .env and fill in. Never commit .env.
ENYGMA_PORT=4073
ENYGMA_HOST=127.0.0.1

# Must match the origin the browser sees, exactly.
ENYGMA_RP_ID=enygma.arkhm.io
ENYGMA_RP_NAME=ENYGMA
ENYGMA_ORIGIN=https://enygma.arkhm.io

# Its own secret. Never PHNTM's. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ENYGMA_SESSION_SECRET=

# Pipeline. "stub" runs the whole app with no key and no network, which is how
# the interface gets built before the bill starts. "gemini" is the real one.
ENYGMA_PIPELINE=stub

# Its own key or its own project, so usage is attributable and either side can
# revoke without touching the other.
ENYGMA_GEMINI_API_KEY=
ENYGMA_GEMINI_MODEL=gemini-3.5-flash

# Uploads.
ENYGMA_MAX_UPLOAD_MB=500

# HiNotes is OFF. Audio arrives by drag and drop. The poller is gated, not
# deleted; set this to 1 and fill in the rest to turn it back on.
ENYGMA_HINOTES_ENABLED=0

# The base URL is not in the handoff: lift it from PHNTM's src/hinotes/ module
# rather than guessing, and confirm it before the first pull.
ENYGMA_HINOTES_BASE=
ENYGMA_HINOTES_PAGE_SIZE=50
ENYGMA_HINOTES_TIMEOUT=30

# Yahya's recorder token. A dead token returns HTTP 200 with an error envelope,
# not a 401, which is why the poller checks the envelope and not the status code.
ENYGMA_HINOTES_TOKEN=

# Minutes of idle before a re-auth sheet is required.
ENYGMA_REAUTH_MINUTES=5

# Set to 1 only for local development over http://localhost.
ENYGMA_INSECURE_COOKIES=0

# The Android app, for passkeys. A passkey belongs to a domain, and Android will
# only let the app use this domain's passkeys if the domain vouches for the app
# at /.well-known/assetlinks.json. The fingerprint is the release signing
# certificate's SHA-256 -- public, and inside every APK handed out:
#     keytool -list -v -keystore enygma.keystore -alias enygma
# Leave both empty where there is no Android build; the file then 404s rather
# than vouching for nothing.
# Summarising is one pass over text; transcription is priced by the length of
# the audio. So the expensive job stays cheap and the cheap job gets the better
# model. Unset means one model does both.
# Which person in the Directory is you. Actions carry an owner, and without
# this "what do I owe anybody" cannot be answered. Spell it exactly as you named
# yourself when you named the speakers.
ENYGMA_OWNER_NAME=

ENYGMA_GEMINI_SUMMARY_MODEL=

ENYGMA_ANDROID_PACKAGE=io.arkhm.enygma
ENYGMA_ANDROID_FINGERPRINT=
